# Copy to backend/.env (git-ignored) and fill in. Read at API startup; real environment variables win.

# The discovery assistant (ADR 0014). Create a key at https://aistudio.google.com/apikey in the Google Cloud
# project that has billing on (paid tier: Google doesn't use prompts to improve its products). Set a budget alert
# in Google Cloud billing as a backstop. Leave empty to turn Ask off.
GEMINI_API_KEY=
# $0.30 / $2.50 per million input / output tokens (Nov 2026). See https://aistudio.google.com/docs/pricing before changing it.
GEMINI_MODEL=gemini-3.5-flash-lite
# Model requests the whole site may make per day (resets at midnight Pacific): the spending cap. A message takes
# 1 to 4 requests, each well under a cent with the settings below, so 200 is roughly a dollar a day at most.
GEMINI_DAILY_CALLS=200
# Output tokens per request (thinking counts too) and thinking level: minimal, low, medium, high or off.
GEMINI_MAX_OUTPUT_TOKENS=1500
GEMINI_THINKING_LEVEL=low

# Limits on Ask messages. Per day = per account (or anonymous browser), and per device = per network address,
# covering every browser and account on it (a household can share one address, so it's set higher).
INROTATION_CHAT_PER_MINUTE=5
INROTATION_CHAT_PER_DAY=25
INROTATION_CHAT_PER_DEVICE_PER_DAY=40
# Keys the hashes that stand in for network addresses and emails in the Ask and sign-in limits (neither is stored). Any long random text, e.g.
# python -c "import secrets; print(secrets.token_hex(32))". Unset: a new key each restart, so device counts reset.
INROTATION_SECRET=

# Deployment settings (M9, ADR 0025). The deployed values live in deploy/.env (deploy/.env.example). Locally:
# INROTATION_PREVIEW_PASSWORD=          a password in front of the whole site (empty = off)
# INROTATION_TRUST_PROXY=1              read the visitor's address from X-Real-IP (only behind deploy/Caddyfile)
# INROTATION_CORS_ORIGINS=http://localhost:5173   origins allowed to call the API from another address


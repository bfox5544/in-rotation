# Copy to deploy/.env on the server (git-ignored, never in an image) and fill in. See docs/deploy.md.
# Make secrets with: openssl rand -hex 32   (hex only: the database password goes into a URL)

# --- Site -------------------------------------------------------------------------------------------
SITE_ADDRESS=inrotation.example.com
# origin_cert: Cloudflare Origin Certificate in CERTS_DIR (origin.pem, origin-key.pem). none: plain HTTP (local tests only).
CADDY_TLS=origin_cert
# Optional address shown on the Contact page (built into the site)
VITE_CONTACT_EMAIL=
# Publish the site on IPv4 only. OVHcloud's Edge Network Firewall doesn't filter IPv6, and Cloudflare reaches
# the server over IPv4 (an A record only). Leave as is unless the server's IPv6 is firewalled too.
HTTP_PORT=0.0.0.0:80
HTTPS_PORT=0.0.0.0:443

# --- Secrets ----------------------------------------------------------------------------------------
# Keys the hashes behind the Ask and sign-in limits.
INROTATION_SECRET=
POSTGRES_DB=in_rotation
POSTGRES_USER=in_rotation
POSTGRES_PASSWORD=

# --- Ask (ADR 0014). Leave GEMINI_API_KEY empty to turn Ask off. ------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DAILY_CALLS=200
GEMINI_MAX_OUTPUT_TOKENS=1500
GEMINI_THINKING_LEVEL=low
INROTATION_CHAT_PER_MINUTE=5
INROTATION_CHAT_PER_DAY=25
INROTATION_CHAT_PER_DEVICE_PER_DAY=40

# --- Folders on the server (defaults shown) ---------------------------------------------------------
# DATA_DIR=/srv/inrotation/data/current
# COVERS_DIR=/srv/inrotation/covers
# AVATARS_DIR=/srv/inrotation/avatars
# BACKUPS_DIR=/srv/inrotation/backups
# CERTS_DIR=/srv/inrotation/certs
# Nightly jobs: time (UTC) and how many days of backups to keep
# JOBS_AT=03:30
# BACKUP_DAYS=14

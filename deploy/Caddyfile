# In Rotation behind Cloudflare (M9, ADR 0025). Caddy serves the built site, proxies /api to the API,
# and terminates HTTPS with a Cloudflare Origin Certificate.
#
# Settings come from deploy/.env through compose:
#   SITE_ADDRESS   the domain, e.g. inrotation.example.com (":80" for a plain local test)
#   CADDY_TLS      origin_cert (default, needs /certs/origin.pem and /certs/origin-key.pem) or none (local test)
{
	admin off
	servers {
		# Only these addresses may tell Caddy the visitor's real address (CF-Connecting-IP).
		# Cloudflare's published ranges, https://www.cloudflare.com/ips/ (checked 2026-11). Update if they change.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(origin_cert) {
	tls /certs/origin.pem /certs/origin-key.pem
}

(none) {
}

(to_api) {
	reverse_proxy api:8000 {
		# The real visitor address (or the connection's own, when it didn't come through Cloudflare).
		header_up X-Real-IP {client_ip}
	}
}

{$SITE_ADDRESS} {
	import {$CADDY_TLS:origin_cert}
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	handle /api/* {
		import to_api
	}
	handle {
		root * /srv
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		header /fonts/* Cache-Control "public, max-age=2592000"
		try_files {path} /index.html
		file_server
	}
}
